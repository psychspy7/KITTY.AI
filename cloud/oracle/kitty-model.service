[Unit]
Description=KITTY llama.cpp model
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kitty-ai
ExecStart=/opt/llama.cpp/build/bin/llama-server --model __KITTY_MODEL_PATH__ --alias kitty --host 127.0.0.1 --port 8080 --ctx-size 4096 --parallel 1 --n-gpu-layers 0 --threads 4 --threads-batch 4 --jinja --chat-template-kwargs {"enable_thinking":false}
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
