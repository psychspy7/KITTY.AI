[Unit]
Description=KITTY Google account gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kitty
Group=kitty
WorkingDirectory=/opt/kitty-ai
ExecStart=/opt/kitty-ai/.venv/bin/python /opt/kitty-ai/server/kitty.py --home /var/lib/kitty serve --bind 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kitty
UMask=0077

[Install]
WantedBy=multi-user.target
