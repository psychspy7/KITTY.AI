{
  "name": "kitty-firebase-backend",
  "version": "0.6.0",
  "private": true,
  "main": "src/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/service.js && node --check src/providers.js",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "deploy": "firebase deploy --only functions:kittyApi,firestore"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": { "@firebase/rules-unit-testing": "^4.0.0", "firebase": "^11.0.0" }
}
