<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#E8C791</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0C101C</item>
        <item name="android:navigationBarColor">#0C101C</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#0C101C</item>
        <item name="android:alertDialogTheme">@style/KittyDialog</item>
    </style>
    <style name="KittyDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">#171E2E</item>
        <item name="android:colorAccent">#E8C791</item>
        <item name="android:textColorPrimary">#F4F0E8</item>
        <item name="android:textColorSecondary">#ADB4C5</item>
    </style>
</resources>
